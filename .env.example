# Server
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Celo Mainnet (Chain ID 42220)
CELO_RPC_URL=https://forno.celo.org
CELO_ATTRIBUTION_TAG=celo_325d8d38061f

# Dedicated Hackathon Agent Wallet (NEVER commit your real private key)
# Leave empty to run in Quote/Preview Mode; set to execute live Celo mainnet swaps & payouts.
AGENT_PRIVATE_KEY=
# Required on mainnet: approving a payout spends the agent wallet, so the dashboard asks for this key
OPERATOR_KEY=

# ERC-8004 & Self Agent ID (fill after registering on Celo mainnet)
ERC8004_AGENT_ID=
SELF_AGENT_ID=

# x402 Facilitator on Celo (https://x402.celo.org)
X402_FACILITATOR_URL=https://api.x402.celo.org
X402_API_KEY=
X402_PAY_TO=

# Textile FX v2 RFQ API (optional partner key; works anonymously with EIP-712 takerProof)
TEXTILE_API_URL=https://api.textilecredit.com
TEXTILE_API_KEY=

# Storage: point at a persistent disk in production so receipts survive redeploys
DATA_DIR=

# Payout Guardrails (USD)
PER_HUMAN_DAILY_CAP_USD=25
AUTO_PAY_MAX_USD=3

